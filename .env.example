# Copy to .env.local for local development, or set these in your hosting
# provider's environment settings. Never commit real values.

# --- Vercel KV (Redis) — REQUIRED ---------------------------------------
# Created automatically when you add a KV store to the project in Vercel.
# Without these the app fails closed: the rate limiter denies every request.
KV_URL=redis://...
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...
KV_REST_API_READ_ONLY_TOKEN=...

# --- Origin allowlist — OPTIONAL ---------------------------------------
# Extra origins accepted by the CSRF check, comma-separated, scheme included.
# Only needed when a proxy in front of the app rewrites the Host header, so the
# request's real origin no longer matches what the app sees. Leave unset on a
# standard Vercel deployment.
# ALLOWED_ORIGINS=https://passshare.example.com,https://www.passshare.example.com
